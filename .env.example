# Copy to .env for local use. Never commit .env or real credentials.

# Root directory for datasets, captures, and generated history (default: ./data)
OBJHIST_DATA_DIR=./data

# Dataset downloads (only needed when fetching the public datasets)
ROBOFLOW_API_KEY=
KAGGLE_USERNAME=
KAGGLE_KEY=

# History service address used by the web app (apps/web), server-side only
OBJHIST_API_URL=http://127.0.0.1:8000

# Generative AI assistant (Claude API; see docs/adr/0002-assistant-claude-sqlite-web.md)
ANTHROPIC_API_KEY=
OBJHIST_LLM_MODEL=claude-opus-5-5
